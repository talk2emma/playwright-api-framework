{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug the current spec",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "${relativeFile}", "--workers=1", "--timeout=0"],
      "env": { "PWDEBUG": "console", "LOG_LEVEL": "debug", "LOG_BODIES": "true" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug the whole suite",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "--workers=1"],
      "env": { "LOG_LEVEL": "debug" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
