# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit a filled-in copy — `.env*` is
# git-ignored except for this template.
#
# Per-environment overrides go in `.env.<TEST_ENV>` (for example `.env.staging`)
# and are layered on top of `.env`.
# ---------------------------------------------------------------------------

# Which named environment from src/config/environments.ts to run against.
TEST_ENV=demo

# Overrides the environment's base URL when set. Leave empty to use the default.
API_BASE_URL=
GRAPHQL_URL=
WS_URL=

# --- Credentials (never hard-code these in source) -------------------------
API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
STANDARD_USERNAME=
STANDARD_PASSWORD=
READONLY_USERNAME=
READONLY_PASSWORD=

# --- OAuth2 client-credentials flow ----------------------------------------
OAUTH_TOKEN_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPE=

# --- HMAC request signing ---------------------------------------------------
HMAC_KEY_ID=
HMAC_SECRET=

# --- Execution tuning -------------------------------------------------------
# Per-request timeout in milliseconds.
API_TIMEOUT=30000
# How many times a retryable request is retried before failing.
RETRY_COUNT=2
# Parallel workers. Empty lets Playwright decide.
WORKERS=
# trace: on | off | retain-on-failure | on-first-retry
TRACE=retain-on-failure
# error | warn | info | debug
LOG_LEVEL=info
# Log every request and response body. Verbose; off by default.
LOG_BODIES=false
# Fail a test when any response exceeds this many milliseconds.
LATENCY_BUDGET_MS=2000
# Validate every response against its registered schema, even when the test
# does not ask for it. Recommended in CI.
STRICT_CONTRACTS=false
# Reject responses whose Content-Type does not match what was requested.
STRICT_CONTENT_TYPE=true
# Port for the built-in mock server used by contract and offline tests.
MOCK_SERVER_PORT=4010
# Emit Allure results in addition to the default reporters.
ALLURE=false
