{
  "name": "playwright-api-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Playwright API automation framework",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:contract": "playwright test --project=contract",
    "test:performance": "playwright test --project=performance",
    "test:security": "playwright test --project=security",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:serial": "playwright test --workers=1",
    "test:failed": "playwright test --last-failed",
    "test:debug": "PWDEBUG=1 playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report reports/html",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "install:browsers": "playwright install --with-deps chromium",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "clean": "rimraf test-results reports playwright-report .cache",
    "prepare": "husky",
    "docs": "npm run docs:api && npm run docs:html && npm run docs:pdf",
    "docs:api": "node scripts/docs/extract-api.mjs",
    "docs:html": "node scripts/docs/build-docs.mjs",
    "docs:pdf": "node scripts/docs/build-pdf.mjs",
    "docs:open": "open docs/site/index.html"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "fast-xml-parser": "^5.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "playwright-ctrf-json-reporter": "^0.0.29",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "zod": "^3.25.76"
  }
}
